# ==============================================================================
# Nexus Environment Configuration Example
# Copy this file to .env.local and update the values with your local/project credentials.
# NOTE: Never commit .env.local or expose private service role keys.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration (Public Client)
# Safe to expose in the browser (client-side)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# ------------------------------------------------------------------------------
# Supabase Configuration (Private / Server-Side Only)
# WARNING: NEVER prefix with NEXT_PUBLIC_ or import in client-side code!
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
